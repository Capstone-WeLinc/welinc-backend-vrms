// npm audit gate for CI: fails on any high or critical hole in what ships (dev tools left out).
// Each allowlist entry needs the reason and a review date. Remove it once a fix ships.
{
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  "high": true,
  "skip-dev": true,
  "allowlist": []
}
