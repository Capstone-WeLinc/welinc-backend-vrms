// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

// Spec 0017: what a stored file is. Labels and accepted types live in attachment-kinds.ts.
enum AttachmentKind {
  VEHICLE_PHOTO
  PROOF
  RECEIPT
  OTHER_DOCUMENT
}

// Spec 0016: how the customer pays for a ticket.
enum TicketAccountType {
  ONLINE
  CORPORATE
}

// Spec 0029 (child 0001): VMMS's values, copied by the fleet sync only. DISABLED is gone.
enum VehicleStatus {
  AVAILABLE
  UNDER_REPAIR
  UNDER_MAINTENANCE
}

// Spec 0029 (child 0002): what a VRMS Admin did with a VMMS referral.
enum ReferralStatus {
  WAITING
  OPENED_TICKET
  ADDED_TO_TICKET
  REJECTED
}

// Spec 0029 (child 0004): the outbox. The system a delivery goes to, what it is, and where it is.
enum DeliveryTarget {
  VMMS
  BMS
}

enum DeliveryKind {
  REPAIR_EVENT
  REFERRAL_REJECTED
  REPAIR_UPDATE
  EXPEDITE_ANSWER
}

// Spec 0029 (child 0003): a BMS expedite request leaves WAITING exactly once.
enum ExpediteStatus {
  WAITING
  ACCEPTED
  DECLINED
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  DISMISSED
}

// Spec 0010. Open is every status except CLOSED and CANCELLED (src/modules/vrms/ticket-statuses.ts).
enum RepairStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  FOR_VERIFICATION
  OUTSOURCED
  PENDING_APPROVAL
  CLOSED
  CANCELLED
}

// Where a ticket's dueAt came from; set and cleared together with dueAt.
enum DueAtSource {
  PRIORITY
  ISSUE_TYPE
  MANUAL
}

enum RepairPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum KnowledgeEntryStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum SuggestionKind {
  CHANGE
  NEW_ENTRY
}

enum SuggestionStatus {
  OPEN
  ACCEPTED
  DISMISSED
}

// ==========================================
// MODELS
// "Who" fields hold a welinc-auth user id with no foreign key, plus a name copied at the time,
// because user rows live in welinc-auth (spec 0009, spec 0010).
// ==========================================

model Vehicle {
  id                String          @id @default(uuid()) @db.Uuid
  plateNumber       String          @unique @map("plate_number") @db.VarChar(20)
  model             String          @db.VarChar(100)
  capacity          Int             @default(0) @map("capacity")
  status            VehicleStatus   @default(AVAILABLE)
  odometer          Int             @default(0)
  isActive          Boolean         @default(true) @map("is_active")
  deletedAt         DateTime?       @map("deleted_at") @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  vehicleTypeId     String?         @map("vehicle_type_id") @db.Uuid // spec 0016: a value of the vehicle_type lookup list
  vehicleType       LookupValue?    @relation(fields: [vehicleTypeId], references: [id], onDelete: Restrict)
  // Spec 0029 (child 0001): a copy of the VMMS truck. Null only until `fleet:link` runs.
  vmmsVehicleId     String?         @unique @map("vmms_vehicle_id") @db.Uuid
  make              String?         @db.VarChar(100)
  truckSizeCategory String?         @map("truck_size_category") @db.VarChar(50)
  garageId          String?         @map("garage_id") @db.Uuid
  syncedAt          DateTime?       @map("synced_at") @db.Timestamptz(6)
  garage            Garage?         @relation(fields: [garageId], references: [id], onDelete: SetNull)
  repairTickets     RepairTicket[]
  changes           VehicleChange[]
  referrals         Referral[]

  @@index([deletedAt])
  @@index([garageId])
  @@map("vehicles")
}

model Garage {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @unique @db.VarChar(50) // Sta. Rosa, Marikina, Pulilan
  isActive      Boolean        @default(true) @map("is_active")
  deletedAt     DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  // Spec 0029 (child 0001): a copy of the VMMS garage. Null only until `fleet:link` runs.
  vmmsGarageId  String?        @unique @map("vmms_garage_id") @db.Uuid
  syncedAt      DateTime?      @map("synced_at") @db.Timestamptz(6)
  repairTickets RepairTicket[]
  vehicles      Vehicle[]

  @@index([deletedAt])
  @@map("garages")
}

// In house mechanics only; each row comes from the roster sync (spec 0009).
model Mechanic {
  id         String   @id @default(uuid()) @db.Uuid
  authUserId String   @unique @map("auth_user_id") @db.Uuid // welinc-auth User.id, no foreign key
  email      String?  @db.VarChar(255) // lowercased copy from welinc-auth
  name       String   @db.VarChar(100)
  isActive   Boolean  @default(true) @map("is_active")
  // The person's VRMS role code (custom ones too, suite spec 0018), written only by MechanicRoster
  role       String?  @db.VarChar(30)
  // Suite spec 0018 child 0002, AC-33: holds ticket.assignable; false keeps them off assign pickers
  assignable Boolean  @default(true)
  // Child 0002, AC-34: holds ticket.verify, the lead mark on the Team section
  isLead     Boolean  @default(false) @map("is_lead")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignments TicketAssignment[]

  @@map("mechanics")
}

// Suite spec 0014 (task 13a): every person holding a VRMS role, permanent or temporary, copied from
// welinc-auth's directory for the Users page. Written only by the directory sync (people-copy.ts).
// An erased person, or one with no VRMS role left, has no row, so no erasure rewrite is needed.
model VrmsPerson {
  authUserId     String   @id @map("auth_user_id") @db.Uuid // welinc-auth User.id, no foreign key
  name           String   @db.VarChar(255)
  email          String   @db.VarChar(255) // lowercased
  // welinc-auth's stored picture path (relative to the gateway), or null
  picture        String?
  // Every VRMS role code the person holds; temporaryRoles is the subset from a temporary grant
  roles          String[]
  temporaryRoles String[] @map("temporary_roles")
  isActive       Boolean  @map("is_active")
  // Soft deleted at welinc-auth: in the grace period, restorable from the portal
  deleted        Boolean
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("vrms_people")
}

model Driver {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @db.VarChar(100)
  licenseNumber String         @unique @map("license_number") @db.VarChar(50)
  isVerified    Boolean        @default(false) @map("is_verified")
  isActive      Boolean        @default(true) @map("is_active")
  deletedAt     DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  repairTickets RepairTicket[]

  @@index([licenseNumber])
  @@index([deletedAt])
  @@map("drivers")
}

model RepairTicket {
  id                 String             @id @default(uuid()) @db.Uuid
  repairNumber       String             @unique @map("repair_number") @db.VarChar(50) // REP-YYYYMMDD-XXXX
  repairStatus       RepairStatus       @default(OPEN) @map("repair_status")
  priority           RepairPriority     @default(MEDIUM)
  vehicleId          String             @map("vehicle_id") @db.Uuid
  driverId           String?            @map("driver_id") @db.Uuid // null only on a ticket opened from a VMMS referral (spec 0029)
  garageId           String             @map("garage_id") @db.Uuid
  odometer           Int
  reportedByUserId   String?            @map("reported_by_user_id") @db.Uuid
  reportedByName     String?            @map("reported_by_name") @db.VarChar(100)
  verifiedByUserId   String?            @map("verified_by_user_id") @db.Uuid // set on the move to CLOSED
  verifiedByName     String?            @map("verified_by_name") @db.VarChar(100)
  verifiedAt         DateTime?          @map("verified_at") @db.Timestamptz(6)
  dueAt              DateTime?          @map("due_at") @db.Timestamptz(6)
  dueAtSource        DueAtSource?       @map("due_at_source")
  partsCost          Decimal?           @map("parts_cost") @db.Decimal(10, 2)
  laborCost          Decimal?           @map("labor_cost") @db.Decimal(10, 2)
  totalCost          Decimal?           @map("total_cost") @db.Decimal(10, 2)
  isLumpSum          Boolean            @default(false) @map("is_lump_sum")
  cancellationReason String?            @map("cancellation_reason") @db.Text
  remarks            String?            @db.Text
  isUnlocked         Boolean            @default(false) @map("is_unlocked")
  unlockReason       String?            @map("unlock_reason") @db.Text
  lastActivityAt     DateTime           @default(now()) @map("last_activity_at") @db.Timestamptz(6) // moved only by a person's audited action
  statusChangedAt    DateTime           @default(now()) @map("status_changed_at") @db.Timestamptz(6) // time of the last status change (spec 0015)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  closedAt           DateTime?          @map("closed_at") @db.Timestamptz(6) // set on the move to CLOSED or CANCELLED
  accountType        TicketAccountType? @map("account_type") // spec 0016
  corporation        String?            @db.VarChar(100) // snapshot of the corporation name, spec 0016
  priorVehicleStatus VehicleStatus?     @map("prior_vehicle_status") // the truck's status just before create, restored on release
  workStartedAt      DateTime?          @map("work_started_at") @db.Timestamptz(6) // first move into IN_PROGRESS or OUTSOURCED, never cleared (spec 0018)
  editedAt           DateTime?          @map("edited_at") @db.Timestamptz(6) // last details, mechanics or issue edit (spec 0019); the audit rows are the record
  editedByUserId     String?            @map("edited_by_user_id") @db.Uuid // welinc-auth User.id, no FK
  editedByName       String?            @map("edited_by_name") @db.VarChar(100)
  vmmsEventVersion   Int                @default(0) @map("vmms_event_version") // the last repair event version VMMS accepted (spec 0029)
  vmmsProviderId     String?            @map("vmms_provider_id") @db.Uuid // VMMS's outside shop, set on the move to OUTSOURCED (spec 0029, AC-36)
  outsideShopName    String?            @map("outside_shop_name") @db.VarChar(150)
  bmsEventVersion    Int                @default(0) @map("bms_event_version") // the last repair update version BMS accepted (spec 0029, child 0003)

  vehicle        Vehicle            @relation(fields: [vehicleId], references: [id])
  driver         Driver?            @relation(fields: [driverId], references: [id], onDelete: Restrict)
  garage         Garage             @relation(fields: [garageId], references: [id])
  issues         RepairIssue[]
  assignments    TicketAssignment[]
  repairParts    RepairPart[]
  auditLogs      AuditLog[]
  aiDiagnoses    AiDiagnosis[]
  attachments    Attachment[]
  vehicleChanges VehicleChange[]
  referrals        Referral[]
  deliveries       Delivery[]
  expediteRequests ExpediteRequest[]

  @@index([repairStatus, createdAt])
  @@index([repairStatus, lastActivityAt])
  @@index([repairStatus, statusChangedAt])
  @@index([dueAt])
  @@index([vehicleId])
  @@map("repair_tickets")
}

// The only link between a ticket and its mechanics. Unassigning deletes the row; the audit log keeps history.
model TicketAssignment {
  id               String   @id @default(uuid()) @db.Uuid
  repairTicketId   String   @map("repair_ticket_id") @db.Uuid
  mechanicId       String   @map("mechanic_id") @db.Uuid
  assignedAt       DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedByUserId String?  @map("assigned_by_user_id") @db.Uuid
  assignedByName   String?  @map("assigned_by_name") @db.VarChar(100)

  repairTicket RepairTicket @relation(fields: [repairTicketId], references: [id], onDelete: Cascade)
  mechanic     Mechanic     @relation(fields: [mechanicId], references: [id])

  @@unique([repairTicketId, mechanicId])
  @@index([mechanicId])
  @@map("ticket_assignments")
}

model RepairIssue {
  id                    String    @id @default(uuid()) @db.Uuid
  repairTicketId        String    @map("repair_ticket_id") @db.Uuid
  description           String    @db.Text
  categoryId            String?   @map("category_id") @db.Uuid
  knowledgeEntryId      String?   @map("knowledge_entry_id") @db.Uuid
  resolutionNote        String?   @map("resolution_note") @db.Text // 5..500, "What fixed it"
  hoursSpent            Decimal?  @map("hours_spent") @db.Decimal(5, 2)
  followedKnownFix      Boolean?  @map("followed_known_fix")
  resolvedAt            DateTime? @map("resolved_at") @db.Timestamptz(6)
  suggestionDismissedAt DateTime? @map("suggestion_dismissed_at") @db.Timestamptz(6)
  // Spec 0023: the checklist lock. Only the checklist paths move it (save, relink, clearsFix, approved suggestion)
  checklistVersion      Int       @default(0) @map("checklist_version")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  repairTicket   RepairTicket          @relation(fields: [repairTicketId], references: [id], onDelete: Cascade)
  category       IssueCategory?        @relation(fields: [categoryId], references: [id])
  knowledgeEntry KnowledgeEntry?       @relation(fields: [knowledgeEntryId], references: [id])
  steps          RepairIssueStep[]
  suggestions    KnowledgeSuggestion[]
  embedding      IssueEmbedding?
  attachments    Attachment[]

  @@index([knowledgeEntryId])
  @@index([knowledgeEntryId, suggestionDismissedAt])
  @@map("repair_issues")
}

/// Spec 0023: where a ticket's checklist step came from.
enum StepOrigin {
  KNOWN_FIX
  ADDED
}

// Copied from the knowledge entry when the issue is linked; editing the entry never changes these.
// Spec 0023: the people working the ticket may add, reword, remove and reorder them.
model RepairIssueStep {
  id             String     @id @default(uuid()) @db.Uuid
  repairIssueId  String     @map("repair_issue_id") @db.Uuid
  position       Int
  text           String     @db.VarChar(300)
  checkedAt      DateTime?  @map("checked_at") @db.Timestamptz(6)
  checkedByEmail String?    @map("checked_by_email") @db.VarChar(255)
  // Spec 0023: copied from a known fix, or added on this ticket; editedAt marks a reworded copy
  origin         StepOrigin @default(KNOWN_FIX)
  editedAt       DateTime?  @map("edited_at") @db.Timestamptz(6)

  repairIssue RepairIssue @relation(fields: [repairIssueId], references: [id], onDelete: Cascade)

  @@unique([repairIssueId, position])
  @@map("repair_issue_steps")
}

model RepairPart {
  id             String   @id @default(uuid()) @db.Uuid
  repairTicketId String   @map("repair_ticket_id") @db.Uuid
  description    String   @db.VarChar(255)
  unitCost       Decimal  @map("unit_cost") @db.Decimal(10, 2)
  quantity       Int      @default(1)
  subtotal       Decimal  @db.Decimal(10, 2) // unitCost * quantity, stored for reporting
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  repairTicket RepairTicket @relation(fields: [repairTicketId], references: [id], onDelete: Cascade)

  @@map("repair_parts")
}

// One row per event; its field changes are a JSON list of { field, before, after } (spec 0010).
// Never updated or deleted by code, and a ticket with audit rows cannot be deleted.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  repairTicketId String?  @map("repair_ticket_id") @db.Uuid // null only for a row about no ticket: a referral rejection or its delivery (spec 0029)
  actorUserId    String?  @map("actor_user_id") @db.Uuid // welinc-auth User.id; null only for system events
  actorName      String?  @map("actor_name") @db.VarChar(100)
  actorEmail     String?  @map("actor_email") @db.VarChar(255)
  actorRole      String?  @map("actor_role") @db.VarChar(30) // ADMIN, CHIEF_MECHANIC, MECHANIC or SYSTEM
  action         String   @db.VarChar(50) // event name from audit-events.ts
  changes        Json     @default("[]")
  note           String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3) // ms precision so keyset cursors match exactly

  repairTicket RepairTicket? @relation(fields: [repairTicketId], references: [id], onDelete: Restrict)

  @@index([repairTicketId, createdAt])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([actorEmail])
  @@index([action])
  @@map("audit_logs")
}

// Spec 0017: one stored file on a ticket. The bytes live in Blob Storage under storageKey; the row
// stays after the purge (purgedAt) so the audit trail can still name the file. Two partial indexes
// live only in the migration SQL: unique (ticket, photo group, sha256) while live, where both photo
// kinds share one group (spec 0018, AC-21), and (deleted_at) for the purge.
model Attachment {
  id               String         @id @db.Uuid // made by the backend before the blob write; part of the key
  repairTicketId   String         @map("repair_ticket_id") @db.Uuid
  issueId          String?        @map("issue_id") @db.Uuid // VEHICLE_PHOTO only, same ticket; no screen sets it since spec 0018
  kind             AttachmentKind // VEHICLE_PHOTO is shown as Before, PROOF as After (spec 0018)
  storageKey       String         @unique @map("storage_key") @db.VarChar(300)
  thumbnailKey     String?        @map("thumbnail_key") @db.VarChar(300)
  fileName         String         @map("file_name") @db.VarChar(255)
  mimeType         String         @map("mime_type") @db.VarChar(100) // of the stored bytes
  sizeBytes        Int            @map("size_bytes")
  width            Int?
  height           Int?
  sha256           String         @db.Char(64) // of the bytes as uploaded
  takenAt          DateTime?      @map("taken_at") @db.Timestamptz(6) // the phone's recorded time, client supplied (spec 0018, AC-12)
  uploadedByUserId String         @map("uploaded_by_user_id") @db.Uuid // welinc-auth id, no FK
  uploadedByName   String         @map("uploaded_by_name") @db.VarChar(100)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt        DateTime?      @map("deleted_at") @db.Timestamptz(6)
  deletedByUserId  String?        @map("deleted_by_user_id") @db.Uuid
  deletedByName    String?        @map("deleted_by_name") @db.VarChar(100)
  purgedAt         DateTime?      @map("purged_at") @db.Timestamptz(6)

  repairTicket RepairTicket @relation(fields: [repairTicketId], references: [id], onDelete: Restrict)
  issue        RepairIssue? @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@index([repairTicketId, kind])
  @@index([issueId])
  @@map("attachments")
}

// ==========================================
// KNOWLEDGE BASE (spec 0007)
// ==========================================

model IssueCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(50)
  nameKey     String   @unique @map("name_key") @db.VarChar(50) // trim + lowercase
  description String?  @db.VarChar(200)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  // Spec 0030, AC-4: "Fix time (hours)", 0.25 to 720; null adds nothing to a ticket's due date
  fixHours    Decimal? @map("fix_hours") @db.Decimal(5, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  entries KnowledgeEntry[]
  issues  RepairIssue[]
  changes KnowledgeEntryChange[]

  @@map("issue_categories")
}

model KnowledgeEntry {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String               @db.VarChar(100)
  nameKey             String               @unique @map("name_key") @db.VarChar(100) // trim + lowercase
  categoryId          String               @map("category_id") @db.Uuid
  status              KnowledgeEntryStatus @default(DRAFT)
  symptoms            String               @db.Text
  descriptionTemplate String?              @map("description_template") @db.Text
  suggestedPriority   RepairPriority       @map("suggested_priority")
  estimatedHours      Decimal?             @map("estimated_hours") @db.Decimal(5, 2)
  safetyNotes         String?              @map("safety_notes") @db.Text
  createdByEmail      String               @map("created_by_email") @db.VarChar(255)
  updatedByEmail      String               @map("updated_by_email") @db.VarChar(255)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  category    IssueCategory          @relation(fields: [categoryId], references: [id])
  steps       KnowledgeEntryStep[]
  parts       KnowledgeEntryPart[]
  issues      RepairIssue[]
  suggestions KnowledgeSuggestion[]
  changes     KnowledgeEntryChange[]

  @@index([status, categoryId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([symptoms(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("knowledge_entries")
}

// 1..20 per entry, saved as a full replace with positions 1..n.
model KnowledgeEntryStep {
  id       String @id @default(uuid()) @db.Uuid
  entryId  String @map("entry_id") @db.Uuid
  position Int
  text     String @db.VarChar(300)

  entry KnowledgeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, position])
  @@map("knowledge_entry_steps")
}

// 0..20 per entry, saved as a full replace with positions 1..n.
model KnowledgeEntryPart {
  id       String @id @default(uuid()) @db.Uuid
  entryId  String @map("entry_id") @db.Uuid
  position Int
  name     String @db.VarChar(100)

  entry KnowledgeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, position])
  @@map("knowledge_entry_parts")
}

model KnowledgeSuggestion {
  id              String           @id @default(uuid()) @db.Uuid
  kind            SuggestionKind
  status          SuggestionStatus @default(OPEN)
  entryId         String?          @map("entry_id") @db.Uuid // required when kind = CHANGE
  repairIssueId   String?          @map("repair_issue_id") @db.Uuid // where it came from, optional
  body            String           @db.Text
  createdByEmail  String           @map("created_by_email") @db.VarChar(255)
  resolvedByEmail String?          @map("resolved_by_email") @db.VarChar(255)
  resolvedAt      DateTime?        @map("resolved_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  entry       KnowledgeEntry? @relation(fields: [entryId], references: [id])
  repairIssue RepairIssue?    @relation(fields: [repairIssueId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("knowledge_suggestions")
}

// The WL-704 change log, shaped like AuditLog: one row per save, its field changes as a JSON list.
model KnowledgeEntryChange {
  id          String   @id @default(uuid()) @db.Uuid
  entryId     String?  @map("entry_id") @db.Uuid
  categoryId  String?  @map("category_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorName   String?  @map("actor_name") @db.VarChar(100)
  actorEmail  String?  @map("actor_email") @db.VarChar(255)
  actorRole   String?  @map("actor_role") @db.VarChar(30)
  action      String   @db.VarChar(50) // ENTRY_CREATED, ENTRY_UPDATED, ENTRY_STATUS, CATEGORY_CREATED, CATEGORY_UPDATED, CATEGORY_STATUS
  changes     Json     @default("[]")
  note        String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  entry    KnowledgeEntry? @relation(fields: [entryId], references: [id])
  category IssueCategory?  @relation(fields: [categoryId], references: [id])

  @@index([entryId, createdAt])
  @@index([categoryId, createdAt])
  @@map("knowledge_entry_changes")
}

// ==========================================
// PERMISSIONS (spec 0011)
// ==========================================

// One row per matrix role and catalog key (src/auth/permissions/catalog.ts). Roles and keys are
// code constants, so no foreign keys. The startup backfill only inserts; locked cells come from
// the catalog, never this table.
model RolePermission {
  role            String   @db.VarChar(30)
  permission      String   @db.VarChar(60)
  allowed         Boolean
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid // welinc-auth User.id; null for System

  @@id([role, permission])
  @@map("role_permissions")
}

// One row (id 1, kept by a check constraint). Each replica compares this version on every
// checked request and reloads its grants when it moves.
// Spec 0005: where VRMS stands in welinc-auth's directory feed (one row, id 'auth', a CHECK in
// the migration). Written only by DirectorySync, and every cursor write carries the lease owner.
model DirectorySyncState {
  id           String    @id
  // Null means the next tick does a full read first
  cursor       String?
  leaseUntil   DateTime? @map("lease_until") @db.Timestamptz(3)
  leaseOwner   String?   @map("lease_owner") @db.Uuid
  // Set while welinc-auth is failing, so the job warns once (AC-15)
  failingSince DateTime? @map("failing_since") @db.Timestamptz(3)
  // The last successful tick
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("directory_sync_state")
}

// Suite spec 0013, AC-29: the matrix sync from welinc-auth (one row, id 'auth', a CHECK in the
// migration). `etag` is the last applied `"v<version>"`; the lease works as directory_sync_state.
model PermissionSyncState {
  id           String    @id
  etag         String?   @db.VarChar(40)
  syncedAt     DateTime? @map("synced_at") @db.Timestamptz(3)
  // Set while welinc-auth is failing (or answers an empty matrix), so the job warns once
  failingSince DateTime? @map("failing_since") @db.Timestamptz(3)
  leaseUntil   DateTime? @map("lease_until") @db.Timestamptz(3)
  leaseOwner   String?   @map("lease_owner") @db.Uuid

  @@map("permission_sync_state")
}

model PermissionMatrix {
  id        Int      @id @db.SmallInt
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("permission_matrix")
}

// Spec 0012: a value an Admin set. No row means the catalog default (src/settings/catalog.ts).
model AppSetting {
  key             String   @id @db.VarChar(60)
  value           Json // a number or a boolean, checked against the catalog on save
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid // welinc-auth User.id; null for System

  @@map("app_settings")
}

// One row (id 1, kept by a check constraint). Read with the matrix version on every checked
// request; a moved version reloads the settings cache.
model SettingsState {
  id        Int      @id @db.SmallInt
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settings_state")
}

// Every effective value change, kept forever. A null actor is System.
model SettingChange {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @db.VarChar(60)
  before      Json // the effective value before, never null
  after       Json // the effective value after, never null
  action      String   @db.VarChar(10) // SET or RESET
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorName   String?  @map("actor_name") @db.VarChar(100)
  actorEmail  String?  @map("actor_email") @db.VarChar(255)
  note        String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([key])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("setting_changes")
}

// ==========================================
// AI (spec 0013)
// ==========================================

// One vector per issue. Prisma can't write the vector column, so rows are upserted with raw SQL;
// a row whose model or text_hash no longer matches is stale and gets embedded again.
model IssueEmbedding {
  issueId   String                     @id @map("issue_id") @db.Uuid
  embedding Unsupported("vector(768)")
  model     String                     @db.VarChar(60)
  textHash  String                     @map("text_hash") @db.Char(64) // SHA 256 hex of the embedded text
  createdAt DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  issue RepairIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@map("issue_embeddings")
}

// One successful diagnosis run, a frozen snapshot of what the AI saw and answered.
model AiDiagnosis {
  id                String   @id @default(uuid()) @db.Uuid
  repairTicketId    String   @map("repair_ticket_id") @db.Uuid
  requestedByUserId String   @map("requested_by_user_id") @db.Uuid // welinc-auth User.id, no FK
  input             Json // { symptom, issues, vehiclePlate, vehicleModel, vehicleHistory }
  similar           Json // [{ issueId, ticketId, repairNumber, description, similarity }]
  result            Json // part prices always stored, nulled on read without ticket.costs.view
  model             String   @db.VarChar(60)
  confidence        String   @db.VarChar(10) // High, Moderate or Low
  latencyMs         Int      @map("latency_ms")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  repairTicket RepairTicket          @relation(fields: [repairTicketId], references: [id], onDelete: Cascade)
  feedback     AiDiagnosisFeedback[]

  @@index([repairTicketId, createdAt(sort: Desc)])
  @@index([requestedByUserId, createdAt])
  @@map("ai_diagnoses")
}

model AiDiagnosisFeedback {
  id          String   @id @default(uuid()) @db.Uuid
  diagnosisId String   @map("diagnosis_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid // welinc-auth User.id, no FK
  helpful     Boolean
  rating      Int?     @db.SmallInt // 1 to 5, checked in the DTO
  comment     String?  @db.Text // up to 500 characters
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  diagnosis AiDiagnosis @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)

  @@unique([diagnosisId, userId])
  @@map("ai_diagnosis_feedback")
}

// ==========================================
// LOOKUP LISTS AND VEHICLE HISTORY (spec 0016)
// ==========================================

// Generic Admin managed plain lists, told apart by `list` (vehicle_type, corporation). Never deleted.
model LookupValue {
  id        String   @id @default(uuid()) @db.Uuid
  list      String   @db.VarChar(40)
  name      String   @db.VarChar(100)
  nameKey   String   @map("name_key") @db.VarChar(100) // trimmed and lowercased
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  vehicles Vehicle[]
  changes  LookupValueChange[]

  @@unique([list, nameKey])
  @@index([list, isActive])
  @@map("lookup_values")
}

model LookupValueChange {
  id            String   @id @default(uuid()) @db.Uuid
  lookupValueId String   @map("lookup_value_id") @db.Uuid
  action        String   @db.VarChar(12) // CREATE, RENAME, DEACTIVATE, REACTIVATE
  before        Json?
  after         Json?
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  actorName     String?  @map("actor_name") @db.VarChar(100)
  actorEmail    String?  @map("actor_email") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  lookupValue LookupValue @relation(fields: [lookupValueId], references: [id])

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("lookup_value_changes")
}

// One history per truck; `field` says what changed (vehicleType today, status with feature 25).
model VehicleChange {
  id             String   @id @default(uuid()) @db.Uuid
  vehicleId      String   @map("vehicle_id") @db.Uuid
  field          String   @db.VarChar(30)
  before         Json?
  after          Json?
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  actorName      String?  @map("actor_name") @db.VarChar(100)
  actorEmail     String?  @map("actor_email") @db.VarChar(255)
  note           String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  repairTicketId String?  @map("repair_ticket_id") @db.Uuid // spec 0020: the ticket behind an automatic status row

  vehicle      Vehicle       @relation(fields: [vehicleId], references: [id])
  repairTicket RepairTicket? @relation(fields: [repairTicketId], references: [id], onDelete: SetNull)

  @@index([vehicleId, createdAt])
  @@index([repairTicketId])
  @@map("vehicle_changes")
}

// ==========================================
// INTEGRATION (spec 0029)
// ==========================================

// A VMMS repair referral (child 0002). The id is VMMS's referralId, so a resend is a duplicate.
model Referral {
  id                    String         @id @db.Uuid
  vehicleId             String         @map("vehicle_id") @db.Uuid
  vmmsVehicleId         String         @map("vmms_vehicle_id") @db.Uuid
  vehiclePlate          String         @map("vehicle_plate") @db.VarChar(20)
  maintenanceScheduleId String         @map("maintenance_schedule_id") @db.Uuid
  workOrderNumber       String         @map("work_order_number") @db.VarChar(40)
  odometerReading       Int            @map("odometer_reading")
  findings              Json // { checklistItemId, label, note }[]
  chiefMechanicRemarks  String?        @map("chief_mechanic_remarks") @db.Text
  status                ReferralStatus @default(WAITING)
  rejectionReason       String?        @map("rejection_reason") @db.Text
  decidedByUserId       String?        @map("decided_by_user_id") @db.Uuid // welinc-auth User.id, no FK
  decidedByName         String?        @map("decided_by_name") @db.VarChar(100)
  decidedAt             DateTime?      @map("decided_at") @db.Timestamptz(6)
  repairTicketId        String?        @map("repair_ticket_id") @db.Uuid
  receivedAt            DateTime       @default(now()) @map("received_at") @db.Timestamptz(6)
  payloadHash           String         @map("payload_hash") @db.Char(64) // SHA 256 of the canonical body as received

  vehicle      Vehicle       @relation(fields: [vehicleId], references: [id])
  repairTicket RepairTicket? @relation(fields: [repairTicketId], references: [id], onDelete: SetNull)
  deliveries   Delivery[]

  @@index([status, receivedAt])
  @@index([vehicleId])
  @@index([repairTicketId])
  @@map("referrals")
}

// Spec 0029 (child 0003): BMS asks VRMS to hurry a repair for one Job Order. The id is BMS's
// requestId; a repeat with the same payloadHash is a duplicate.
model ExpediteRequest {
  id              String          @id @db.Uuid
  repairTicketId  String          @map("repair_ticket_id") @db.Uuid
  jobOrderNumber  String          @map("job_order_number") @db.VarChar(40)
  reason          String          @db.Text
  neededBy        DateTime?       @map("needed_by") @db.Date
  status          ExpediteStatus  @default(WAITING)
  responseReason  String?         @map("response_reason") @db.Text
  newPriority     RepairPriority? @map("new_priority")
  newDueAt        DateTime?       @map("new_due_at") @db.Timestamptz(6)
  decidedByUserId String?         @map("decided_by_user_id") @db.Uuid // welinc-auth User.id, no FK; null for an auto decline
  decidedByName   String?         @map("decided_by_name") @db.VarChar(100)
  decidedAt       DateTime?       @map("decided_at") @db.Timestamptz(6)
  receivedAt      DateTime        @default(now()) @map("received_at") @db.Timestamptz(6)
  payloadHash     String          @map("payload_hash") @db.Char(64) // SHA 256 of the canonical body as received

  repairTicket RepairTicket @relation(fields: [repairTicketId], references: [id], onDelete: Restrict)
  deliveries   Delivery[]

  @@index([status, receivedAt])
  @@index([repairTicketId, status])
  @@map("expedite_requests")
}

// The outbox (child 0004). Written only by enqueueDelivery, in the transaction of the change it
// reports; sent by DeliveryWorker. The id is the eventId sent.
model Delivery {
  id               String         @id @db.Uuid
  seq              BigInt         @unique @default(autoincrement()) // stable send order, even for two rows from one save
  target           DeliveryTarget
  kind             DeliveryKind
  payload          Json
  status           DeliveryStatus @default(PENDING)
  attempts         Int            @default(0)
  firstAttemptAt   DateTime?      @map("first_attempt_at") @db.Timestamptz(6)
  nextAttemptAt    DateTime       @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastAttemptAt    DateTime?      @map("last_attempt_at") @db.Timestamptz(6)
  lastStatusCode   Int?           @map("last_status_code")
  lastError        String?        @map("last_error") @db.VarChar(500)
  sentAt           DateTime?      @map("sent_at") @db.Timestamptz(6)
  manualRetryCount Int            @default(0) @map("manual_retry_count")
  dismissReason    String?        @map("dismiss_reason") @db.Text
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  repairTicketId   String?        @map("repair_ticket_id") @db.Uuid
  referralId        String?        @map("referral_id") @db.Uuid
  expediteRequestId String?        @map("expedite_request_id") @db.Uuid

  repairTicket    RepairTicket?    @relation(fields: [repairTicketId], references: [id], onDelete: SetNull)
  referral        Referral?        @relation(fields: [referralId], references: [id], onDelete: SetNull)
  expediteRequest ExpediteRequest? @relation(fields: [expediteRequestId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([target, repairTicketId, createdAt])
  @@map("deliveries")
}
