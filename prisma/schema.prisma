// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum VehicleStatus {
  AVAILABLE
  UNDER_REPAIR
  UNDER_MAINTENANCE
}

enum RepairStatus {
  PENDING
  IN_PROGRESS
  FOR_VERIFICATION
  COMPLETED
  CANCELLED
}

enum AccountType {
  IN_HOUSE
  OUTSOURCED
}

enum MaintenanceStatus {
  PENDING
  DUE
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum MaintenanceTriggerType {
  MANUAL
  ODOMETER
  TIME
}

enum MaintenanceIntervalType {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMI_ANNUALLY
  ANNUALLY
}

enum RepairPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum KnowledgeEntryStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum SuggestionKind {
  CHANGE
  NEW_ENTRY
}

enum SuggestionStatus {
  OPEN
  ACCEPTED
  DISMISSED
}

// ==========================================
// MODELS
// ==========================================

model Booking {
  id                         String    @id @default(uuid()) @db.Uuid
  bookingId                  String    @unique @map("booking_id") @db.VarChar(50)
  client                     String    @db.VarChar(200)
  service                    String    @db.VarChar(100)
  serviceType                String?   @map("service_type") @db.VarChar(120)
  deliveryCategory           String?   @map("delivery_category") @db.VarChar(40)
  date                       String    @db.Text
  address                    String?   @db.Text
  pickupAddress              String?   @map("pickup_address") @db.Text
  deliveryAddress            String?   @map("delivery_address") @db.Text
  status                     String    @default("For Plotting") @map("status") @db.Text
  amount                     Decimal?  @db.Decimal(10, 2)
  totalAmount                String?   @map("total_amount") @db.Text
  paymentStatus              String?   @default("Pending") @map("payment_status") @db.Text
  paymentMethod              String?   @map("payment_method") @db.Text
  fullName                   String?   @map("full_name") @db.VarChar(200)
  contact                    String?   @db.Text
  email                      String?   @db.Text
  deliveryLocation           String?   @map("delivery_location") @db.Text
  estimatedItems             Int?      @map("estimated_items")
  itemDetails                String?   @map("item_details") @db.Text
  specialInstructions        String?   @map("special_instructions") @db.Text
  notes                      String?   @db.Text
  discrepancyNote            String?   @map("discrepancy_note") @db.Text
  flagged                    Boolean   @default(false) @map("flagged")
  servicesAvailed            String[]  @default([]) @map("services_availed")
  protectiveMaterials        String[]  @default([]) @map("protective_materials")
  additionalServicesAvailed  Json?     @map("additional_services_availed")
  hasInsurance               Boolean   @default(false) @map("has_insurance")
  permitRequired             Boolean   @default(false) @map("permit_required")
  time                       String?   @map("time") @db.Text
  garage                     String?   @map("garage") @db.Text
  deliveryType               String?   @map("delivery_type") @db.Text
  vehicleId                  String?   @map("vehicle_id") @db.Uuid
  driverId                   String?   @map("driver_id") @db.Uuid
  helperIds                  String[]  @map("helper_ids")
  deletedAt                  DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  vehicle                    Vehicle?  @relation(fields: [vehicleId], references: [id])
  driver                     Driver?   @relation(fields: [driverId], references: [id])

  @@index([deletedAt])
  @@map("bookings")
}

model Vehicle {
  id            String         @id @default(uuid()) @db.Uuid
  plateNumber   String         @unique @map("plate_number") @db.VarChar(20)
  model         String         @db.VarChar(100)
  capacity      Int            @default(0) @map("capacity")
  status        VehicleStatus  @default(AVAILABLE)
  odometer      Int            @default(0)
  isActive      Boolean        @default(true) @map("is_active")
  deletedAt     DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  repairTickets RepairTicket[]
  bookings      Booking[]

  @@index([deletedAt])
  @@map("vehicles")
}

model Garage {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @unique @db.VarChar(50) // Sta. Rosa, Marikina, Pulilan
  isActive      Boolean        @default(true) @map("is_active")
  deletedAt     DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  repairTickets RepairTicket[]

  @@index([deletedAt])
  @@map("garages")
}

model Mechanic {
  id           String   @id @default(uuid()) @db.Uuid
  authUserId   String?  @unique @map("auth_user_id") @db.Uuid // welinc-auth User.id, no foreign key; null for outsourced (spec 0009)
  email        String?  @db.VarChar(255) // lowercased copy from welinc-auth
  name         String   @db.VarChar(100)
  isOutsourced Boolean  @default(false) @map("is_outsourced")
  shopName     String?  @map("shop_name") @db.VarChar(100) // For outsourced "Other" shop names
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  repairTickets RepairTicket[] @relation("RepairTicketMechanics")

  @@map("mechanics")
}

model Driver {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @db.VarChar(100)
  licenseNumber String         @unique @map("license_number") @db.VarChar(50)
  isVerified    Boolean        @default(false) @map("is_verified")
  isActive      Boolean        @default(true) @map("is_active")
  deletedAt     DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  repairTickets RepairTicket[]
  bookings      Booking[]

  @@index([licenseNumber])
  @@index([deletedAt])
  @@map("drivers")
}

model RepairTicket {
  id                       String       @id @default(uuid()) @db.Uuid
  repairNumber             String       @unique @map("repair_number") @db.VarChar(50) // REP-YYYYMMDD-XXXX
  repairStatus             RepairStatus @default(PENDING) @map("repair_status")
  vehicleId                String       @map("vehicle_id") @db.Uuid
  driverId                 String       @map("driver_id") @db.Uuid
  garageId                 String       @map("garage_id") @db.Uuid
  odometer                 Int
  targetDueDate            DateTime?    @map("target_due_date") @db.Timestamptz(6)
  durationDays             Int?         @map("duration_days")
  durationHours            Int?         @map("duration_hours")
  partsCost                Decimal?     @map("parts_cost") @db.Decimal(10, 2)
  laborCost                Decimal?     @map("labor_cost") @db.Decimal(10, 2)
  totalCost                Decimal?     @map("total_cost") @db.Decimal(10, 2)
  isLumpSum                Boolean      @default(false) @map("is_lump_sum")
  cancellationReason       String?      @map("cancellation_reason") @db.Text
  failedVerificationReason String?      @map("failed_verification_reason") @db.Text
  remarks                  String?      @db.Text
  isUnlocked               Boolean      @default(false) @map("is_unlocked")
  unlockReason             String?      @map("unlock_reason") @db.Text
  isArchived               Boolean      @default(false) @map("is_archived")
  createdAt                DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt              DateTime?    @map("completed_at") @db.Timestamptz(6)

  vehicle        Vehicle          @relation(fields: [vehicleId], references: [id])
  driver         Driver           @relation(fields: [driverId], references: [id])
  garage         Garage           @relation(fields: [garageId], references: [id])
  issues         RepairIssue[]
  mechanics      Mechanic[]       @relation("RepairTicketMechanics")
  repairParts    RepairPart[]
  shopChangeLogs ShopChangeLog[]
  auditLogs      AuditLog[]

  @@index([repairStatus, createdAt])
  @@index([vehicleId])
  @@map("repair_tickets")
}

model RepairIssue {
  id                    String    @id @default(uuid()) @db.Uuid
  repairTicketId        String    @map("repair_ticket_id") @db.Uuid
  description           String    @db.Text
  categoryId            String?   @map("category_id") @db.Uuid
  knowledgeEntryId      String?   @map("knowledge_entry_id") @db.Uuid
  resolutionNote        String?   @map("resolution_note") @db.Text // 5..500, "What fixed it"
  hoursSpent            Decimal?  @map("hours_spent") @db.Decimal(5, 2)
  followedKnownFix      Boolean?  @map("followed_known_fix")
  resolvedAt            DateTime? @map("resolved_at") @db.Timestamptz(6)
  suggestionDismissedAt DateTime? @map("suggestion_dismissed_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  repairTicket   RepairTicket          @relation(fields: [repairTicketId], references: [id], onDelete: Cascade)
  category       IssueCategory?        @relation(fields: [categoryId], references: [id])
  knowledgeEntry KnowledgeEntry?       @relation(fields: [knowledgeEntryId], references: [id])
  steps          RepairIssueStep[]
  suggestions    KnowledgeSuggestion[]

  @@index([knowledgeEntryId])
  @@index([knowledgeEntryId, suggestionDismissedAt])
  @@map("repair_issues")
}

// Copied from the knowledge entry when the issue is linked; editing the entry never changes these.
model RepairIssueStep {
  id             String    @id @default(uuid()) @db.Uuid
  repairIssueId  String    @map("repair_issue_id") @db.Uuid
  position       Int
  text           String    @db.VarChar(300)
  checkedAt      DateTime? @map("checked_at") @db.Timestamptz(6)
  checkedByEmail String?   @map("checked_by_email") @db.VarChar(255)

  repairIssue RepairIssue @relation(fields: [repairIssueId], references: [id], onDelete: Cascade)

  @@unique([repairIssueId, position])
  @@map("repair_issue_steps")
}

model RepairPart {
  id             String      @id @default(uuid()) @db.Uuid
  repairTicketId String      @map("repair_ticket_id") @db.Uuid
  description    String      @db.VarChar(255)
  unitCost       Decimal     @map("unit_cost") @db.Decimal(10, 2)
  quantity       Int         @default(1)
  subtotal       Decimal     @db.Decimal(10, 2) // unitCost * quantity, stored for reporting
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  repairTicket RepairTicket @relation(fields: [repairTicketId], references: [id], onDelete: Cascade)

  @@map("repair_parts")
}

model ShopChangeLog {
  id             String      @id @default(uuid()) @db.Uuid
  repairTicketId String      @map("repair_ticket_id") @db.Uuid
  changedByUserId String     @map("changed_by_user_id") @db.Uuid
  changedByName  String      @map("changed_by_name") @db.VarChar(100)
  previousValue  String      @map("previous_value") @db.VarChar(255)
  newValue       String      @map("new_value") @db.VarChar(255)
  changedAt      DateTime    @default(now()) @map("changed_at") @db.Timestamptz(6)

  repairTicket RepairTicket @relation(fields: [repairTicketId], references: [id], onDelete: Cascade)

  @@map("shop_change_logs")
}

model AuditLog {
  id             String      @id @default(uuid()) @db.Uuid
  repairTicketId String      @map("repair_ticket_id") @db.Uuid
  userId         String?     @map("user_id") @db.Uuid // welinc-auth User.id; null on backfilled CREATED rows
  email          String?     @db.VarChar(100)
  actorName      String?     @map("actor_name") @db.VarChar(100) // the actor's name when the row was written (spec 0009)
  action         String      @db.VarChar(100) // CREATED, STATUS_CHANGE, COST_UPDATE, UNLOCK, SHOP_CHANGE
  fieldName      String?     @map("field_name") @db.VarChar(50)
  previousValue  String?     @map("previous_value") @db.Text
  newValue       String?     @map("new_value") @db.Text
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3) // ms precision so keyset cursors match exactly

  repairTicket RepairTicket @relation(fields: [repairTicketId], references: [id], onDelete: Cascade)

  @@index([repairTicketId, createdAt])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([email])
  @@index([action])
  @@map("audit_logs")
}

model ChecklistTemplate {
  id        String            @id @default(uuid()) @db.Uuid
  type      String            @db.VarChar(100) // Oil Change, Brake Inspection, etc.
  items     ChecklistItem[]
  schedules MaintenanceSchedule[]
  deletedAt DateTime?         @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([type])
  @@index([deletedAt])
  @@map("checklist_templates")
}

model ChecklistItem {
  id                 String   @id @default(uuid()) @db.Uuid
  checklistTemplateId String  @map("checklist_template_id") @db.Uuid
  text               String   @db.Text
  order              Int      @default(0)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  checklistTemplate ChecklistTemplate @relation(fields: [checklistTemplateId], references: [id], onDelete: Cascade)

  @@index([checklistTemplateId])
  @@index([deletedAt])
  @@map("checklist_items")
}

model MaintenanceSchedule {
  id                       String            @id @default(uuid()) @db.Uuid
  vehicleId                String            @db.VarChar(50)
  title                    String            @db.VarChar(100)
  garageId                 String?           @map("garage_id") @db.VarChar(50)
  status                   MaintenanceStatus @default(PENDING)
  assignedMechanic         String            @map("assigned_mechanic") @db.VarChar(100)
  accountType              AccountType?      @map("account_type")
  checklistTemplateId      String?           @map("checklist_template_id") @db.Uuid
  odometerReading          Int?              @map("odometer_reading")
  triggerType              MaintenanceTriggerType? @map("trigger_type")
  intervalKm               Int?              @map("interval_km")
  bufferDistanceKm         Int?              @map("buffer_distance_km")
  startingReferenceReadingKm Int?           @map("starting_reference_reading_km")
  intervalType             MaintenanceIntervalType? @map("interval_type")
  startReferenceDate       DateTime?         @map("start_reference_date") @db.Timestamptz(6)
  previousScheduleId       String?           @unique @map("previous_schedule_id") @db.Uuid
  workOrderProgress        Json?             @map("work_order_progress")
  deletedAt                DateTime?         @map("deleted_at") @db.Timestamptz(6)
  createdAt                DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  checklistTemplate ChecklistTemplate? @relation(fields: [checklistTemplateId], references: [id], onDelete: SetNull)
  previousSchedule   MaintenanceSchedule? @relation("MaintenanceScheduleRecurrence", fields: [previousScheduleId], references: [id], onDelete: SetNull)
  nextSchedule       MaintenanceSchedule? @relation("MaintenanceScheduleRecurrence")

  @@index([checklistTemplateId])
  @@index([deletedAt])
  @@map("maintenance_schedules")
}

// ==========================================
// KNOWLEDGE BASE (spec 0007)
// "Who" fields hold the JWT email with no foreign key, like AuditLog, because user rows live in welinc-auth.
// ==========================================

model IssueCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(50)
  nameKey     String   @unique @map("name_key") @db.VarChar(50) // trim + lowercase
  description String?  @db.VarChar(200)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  entries KnowledgeEntry[]
  issues  RepairIssue[]
  changes KnowledgeEntryChange[]

  @@map("issue_categories")
}

model KnowledgeEntry {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String               @db.VarChar(100)
  nameKey             String               @unique @map("name_key") @db.VarChar(100) // trim + lowercase
  categoryId          String               @map("category_id") @db.Uuid
  status              KnowledgeEntryStatus @default(DRAFT)
  symptoms            String               @db.Text
  descriptionTemplate String?              @map("description_template") @db.Text
  suggestedPriority   RepairPriority       @map("suggested_priority")
  estimatedHours      Decimal?             @map("estimated_hours") @db.Decimal(5, 2)
  safetyNotes         String?              @map("safety_notes") @db.Text
  createdByEmail      String               @map("created_by_email") @db.VarChar(255)
  updatedByEmail      String               @map("updated_by_email") @db.VarChar(255)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  category    IssueCategory          @relation(fields: [categoryId], references: [id])
  steps       KnowledgeEntryStep[]
  parts       KnowledgeEntryPart[]
  issues      RepairIssue[]
  suggestions KnowledgeSuggestion[]
  changes     KnowledgeEntryChange[]

  @@index([status, categoryId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([symptoms(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("knowledge_entries")
}

// 1..20 per entry, saved as a full replace with positions 1..n.
model KnowledgeEntryStep {
  id       String @id @default(uuid()) @db.Uuid
  entryId  String @map("entry_id") @db.Uuid
  position Int
  text     String @db.VarChar(300)

  entry KnowledgeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, position])
  @@map("knowledge_entry_steps")
}

// 0..20 per entry, saved as a full replace with positions 1..n.
model KnowledgeEntryPart {
  id       String @id @default(uuid()) @db.Uuid
  entryId  String @map("entry_id") @db.Uuid
  position Int
  name     String @db.VarChar(100)

  entry KnowledgeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, position])
  @@map("knowledge_entry_parts")
}

model KnowledgeSuggestion {
  id              String           @id @default(uuid()) @db.Uuid
  kind            SuggestionKind
  status          SuggestionStatus @default(OPEN)
  entryId         String?          @map("entry_id") @db.Uuid // required when kind = CHANGE
  repairIssueId   String?          @map("repair_issue_id") @db.Uuid // where it came from, optional
  body            String           @db.Text
  createdByEmail  String           @map("created_by_email") @db.VarChar(255)
  resolvedByEmail String?          @map("resolved_by_email") @db.VarChar(255)
  resolvedAt      DateTime?        @map("resolved_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  entry       KnowledgeEntry? @relation(fields: [entryId], references: [id])
  repairIssue RepairIssue?    @relation(fields: [repairIssueId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("knowledge_suggestions")
}

// The WL-704 change log, shaped like AuditLog: one row per changed field.
model KnowledgeEntryChange {
  id            String   @id @default(uuid()) @db.Uuid
  entryId       String?  @map("entry_id") @db.Uuid
  categoryId    String?  @map("category_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  email         String   @db.VarChar(255)
  action        String   @db.VarChar(50) // ENTRY_CREATED, ENTRY_UPDATED, ENTRY_STATUS, CATEGORY_CREATED, CATEGORY_UPDATED, CATEGORY_STATUS
  fieldName     String?  @map("field_name") @db.VarChar(50)
  previousValue String?  @map("previous_value") @db.Text
  newValue      String?  @map("new_value") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  entry    KnowledgeEntry? @relation(fields: [entryId], references: [id])
  category IssueCategory?  @relation(fields: [categoryId], references: [id])

  @@index([entryId, createdAt])
  @@map("knowledge_entry_changes")
}
