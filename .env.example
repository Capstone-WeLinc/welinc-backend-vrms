# Environment Configuration
PORT=3002
NODE_ENV=development

# Extra browser origins allowed by CORS, comma separated (localhost is always allowed)
CORS_ORIGINS=http://localhost:8000,http://localhost:8001

# Analytics and AI service. Inside Docker the default is http://vrms-analytics-ai:8020
AI_SERVICE_URL=http://localhost:8020

# Database Connection (Docker local config by default)
DATABASE_URL="postgresql://welinc_vrms_user:welinc_vrms_pass@localhost:5433/welinc_vrms_db?schema=public"

# Must match welinc-auth's JWT_SECRET: VRMS checks the token signature before asking welinc-auth
JWT_SECRET="your_super_secret_jwt_key_please_change_in_production"

# welinc-auth base URL, required (spec 0009). VRMS asks it who each caller is.
# Inside Docker it is http://auth-service:3001
AUTH_SERVICE_URL=http://localhost:3001
