# Environment Configuration
PORT=3002
NODE_ENV=development

# Spec 0008: npm run seed refuses when NODE_ENV=production. Set SEED_ALLOW=staging only in the
# staging environment's settings to let it run there. Never set it on production (production runs
# npm run seed -- --reference, which needs no flag). Any other value counts as unset.
# SEED_ALLOW=

# Required (spec 0010). Browser origins allowed by CORS, comma separated, each a bare origin like
# https://host (no path, no trailing slash). Local development origins are always allowed.
CORS_ORIGINS=http://localhost:8000,http://localhost:8001

# Database Connection (Docker local config by default)
DATABASE_URL="postgresql://welinc_vrms_user:welinc_vrms_pass@localhost:5433/welinc_vrms_db?schema=public"
# Most connections this service opens at once (spec 0008: 3 when hosted, a server has about 35)
DB_POOL_MAX=5

# Token check (spec 0002, src/auth/verify/README.md). All three are required.
# The issuer, the identical string every service sets. An identifier, never fetched.
AUTH_ISSUER=http://localhost:3000/auth
# welinc-auth's published keys. Inside Docker: http://auth-service:3001/auth/.well-known/jwks.json
AUTH_JWKS_URL=http://localhost:3001/auth/.well-known/jwks.json
# welinc-auth on the internal network: VRMS asks it who each caller is (spec 0009).
# Inside Docker it is http://auth-service:3001
AUTH_INTERNAL_URL=http://localhost:3001
# The suite gateway on the internal network, for VRMS's calls to VMMS and BMS (spec 0029).
# Inside Docker it is http://api-gateway:3000
SUITE_GATEWAY_INTERNAL_URL=http://localhost:3000
# VRMS's own identity at welinc-auth, for its service token (spec 0002). Both required.
AUTH_CLIENT_ID=vrms
# Private EC P-256 JWK with kid and alg ES256, one line of JSON. Secret. Written by
# `npm run keys:dev` in welinc-auth locally; `npm run keys:client` for staging and production.
AUTH_CLIENT_PRIVATE_KEY=

# Sessions (spec 0003, src/session/). All four addresses are required; in production each must be https
# and not localhost (spec 0010).
# Where users land after login, and the one Origin the session cookie routes accept.
WEB_APP_URL=http://localhost:8001
# The portal: login failures and signed out users go there.
PORTAL_URL=http://localhost:8000
# welinc-auth as the browser sees it, for /auth/authorize (not AUTH_INTERNAL_URL).
AUTH_PUBLIC_URL=http://localhost:3000/auth
# The gateway address the browser sees. <API_PUBLIC_URL>/vrms/session/callback must equal the
# VRMS redirect address in welinc-auth's client registry, character for character.
API_PUBLIC_URL=http://localhost:3000
# true or false. Must be true in production: the cookies become __Secure-vrms_rt and __Secure-vrms_login_* with Secure.
SESSION_COOKIE_SECURE=false
# Proxy hops in front of backend-vrms, so the user's address forwarded to welinc-auth is real:
# 1 locally (nginx), 2 hosted. 0 trusts none; production refuses 0 (spec 0010).
TRUST_PROXY_HOPS=1

# VRMS spec 0026: true or false. The API docs at /vrms/docs (Scalar) and /vrms/docs/openapi.json.
# Blank means on unless NODE_ENV=production. Hosted, the Bicep sets it: true on staging, false on production.
API_DOCS_ENABLED=

# AI diagnosis and embeddings (spec 0013). Empty key: the app starts, AI answers 503 and nothing is embedded.
# Keep the whole key (it starts with AQ.); never put it in a VITE_* variable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2

# File storage for ticket attachments (spec 0017). Set one of the two (production requires one); neither set
# in development: the app starts with a warning and attachment routes answer 503 STORAGE_UNAVAILABLE.
# Local only: the Azurite connection string (its account key is Azurite's public development key).
# From the host, BlobEndpoint is http://localhost:10000/devstoreaccount1; inside Docker, http://azurite:10000/devstoreaccount1
STORAGE_CONNECTION_STRING=
# Azure only: https://<account>.blob.core.windows.net, signed in with the managed identity (no key)
STORAGE_ACCOUNT_URL=
# Container name, created private on startup if missing
STORAGE_CONTAINER=vrms-attachments
# Optional: the host the browser uses for file links (local: http://localhost:10000/devstoreaccount1)
STORAGE_PUBLIC_URL=

# Error monitoring (VRMS spec 0025). Leave all four blank locally: monitoring is off and nothing is sent.
# Prove it on staging, not from your laptop: a local app with SENTRY_ENVIRONMENT=staging reports as
# staging, and its directory poll check ins mix with staging's (false misses on the cron monitor).
# After changing any of these, recreate the container (docker compose -f docker-compose.vrms.yml up -d vrms-backend).
# The DSN can only send events, so it is not a secret. Hosted, the Bicep sets all of these.
SENTRY_DSN=
# staging or production; required when SENTRY_DSN is set
SENTRY_ENVIRONMENT=
# The commit SHA. Hosted, the image bakes it in from the GIT_SHA build argument.
SENTRY_RELEASE=
# true or false. Staging only: POST /vrms/debug/sentry-test throws a test error (needs settings.manage).
# Refused with SENTRY_ENVIRONMENT=production.
SENTRY_TEST_ROUTES=
