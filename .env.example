# Environment Configuration
PORT=3002
NODE_ENV=development

# Database Connection (Docker local config by default)
DATABASE_URL="postgresql://welinc_vrms_user:welinc_vrms_pass@localhost:5433/welinc_vrms_db?schema=public"

# Authentication & JWT Configuration
JWT_SECRET="your_super_secret_jwt_key_please_change_in_production"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Semaphore PH SMS Gateway Configuration
SEMAPHORE_API_KEY="your_semaphore_api_key_here"
SEMAPHORE_SENDER_NAME="WELINC"
SEMAPHORE_DRY_RUN=true

# Email (OTP and password reset). Leave blank to log emails instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=WeLinc Logistics <no-reply@welinc.com>
