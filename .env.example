# Environment Configuration
PORT=3002
NODE_ENV=development

# Extra browser origins allowed by CORS, comma separated (localhost is always allowed)
CORS_ORIGINS=http://localhost:8000,http://localhost:8001

# Database Connection (Docker local config by default)
DATABASE_URL="postgresql://welinc_vrms_user:welinc_vrms_pass@localhost:5433/welinc_vrms_db?schema=public"

# Token check (spec 0002, src/auth/verify/README.md). All three are required.
# The issuer, the identical string every service sets. An identifier, never fetched.
AUTH_ISSUER=http://localhost:3000/auth
# welinc-auth's published keys. Inside Docker: http://auth-service:3001/auth/.well-known/jwks.json
AUTH_JWKS_URL=http://localhost:3001/auth/.well-known/jwks.json
# welinc-auth on the internal network: VRMS asks it who each caller is (spec 0009).
# Inside Docker it is http://auth-service:3001
AUTH_INTERNAL_URL=http://localhost:3001
# VRMS's own identity at welinc-auth, for its service token (spec 0002). Both required.
AUTH_CLIENT_ID=vrms
# Private EC P-256 JWK with kid and alg ES256, one line of JSON. Secret. Written by
# `npm run keys:dev` in welinc-auth locally; `npm run keys:client` for staging and production.
AUTH_CLIENT_PRIVATE_KEY=

# AI diagnosis and embeddings (spec 0013). Empty key: the app starts, AI answers 503 and nothing is embedded.
# Keep the whole key (it starts with AQ.); never put it in a VITE_* variable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2

# File storage for ticket attachments (spec 0017). Set one of the two; neither set: the app starts and
# attachment routes answer 503 STORAGE_UNAVAILABLE.
# Local only: the Azurite connection string (its account key is Azurite's public development key).
# From the host, BlobEndpoint is http://localhost:10000/devstoreaccount1; inside Docker, http://azurite:10000/devstoreaccount1
STORAGE_CONNECTION_STRING=
# Azure only: https://<account>.blob.core.windows.net, signed in with the managed identity (no key)
STORAGE_ACCOUNT_URL=
# Container name, created private on startup if missing
STORAGE_CONTAINER=vrms-attachments
# Optional: the host the browser uses for file links (local: http://localhost:10000/devstoreaccount1)
STORAGE_PUBLIC_URL=
